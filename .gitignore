__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Internal corpus and its raw per-file output must never be committed.
# See docs/poc/internal-hwp-corpus-report.md section 0.
internal-corpus/
artifacts/internal-hwp-poc/
*.corpus-mapping.json

# Throwaway PostgreSQL cluster for the search PoC
.search-poc-pgdata/

# Regenerable chunking/embedding model caches and binary intermediates.
.chunking-embedding-cache/
artifacts/chunking-embedding-poc/*.npy
artifacts/chunking-embedding-poc/*.npz
artifacts/chunking-embedding-poc/*.safetensors

# Throwaway PostgreSQL cluster for migration tests
.migration-test-pgdata/

# Deployment secrets. .env.example is tracked; .env is not.
.env
.env.*
!.env.example
