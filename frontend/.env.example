# Base URL for the API. Default "/api/v1" goes through the Vite dev proxy,
# so the browser stays on one origin and CORS is not involved.
VITE_API_BASE_URL=/api/v1

# Where the dev proxy forwards /api. Development only.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
VITE_DEV_PORT=5173

# Development identity ONLY.
#
# Real SSO is not implemented yet, so the backend accepts X-Debug-User-Id
# outside production. Put a real users.id here in .env.local (git-ignored).
# The header is attached only in a dev build: production builds compile the
# branch out entirely, so this value can never reach a deployed bundle.
VITE_DEBUG_USER_ID=
