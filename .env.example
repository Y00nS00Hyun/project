# Deployment configuration for the single-VM docker compose stack.
#
#   cp .env.example .env   &&   edit .env
#
# .env is git-ignored. Never put a real password or API key in this file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# "production" makes the API fail closed: SSO is not implemented yet, so every
# request is rejected with 401 until an identity provider exists. Do not set
# this to development/test on a deployed VM -- that enables the debug identity
# header.
APP_ENV=production

# Host port for nginx. The only port this stack publishes.
APP_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=docsearch
POSTGRES_USER=docsearch
# Required. Generate one, e.g. `openssl rand -base64 24`. No default is
# supplied on purpose.
POSTGRES_PASSWORD=

# Must match the three values above. "postgres" is the compose service name;
# the database is not reachable from outside the compose network.
# Alembic wants the +psycopg form and the application strips it back off, so
# this single value works for both.
DATABASE_URL=postgresql+psycopg://docsearch:CHANGE_ME@postgres:5432/docsearch

# ---------------------------------------------------------------------------
# Shared folder
# ---------------------------------------------------------------------------
# Absolute host path of the folder to index. Required -- there is deliberately
# no default, because silently scanning the wrong directory is worse than
# refusing to start. Mounted read-only; the system never writes to it.
SHARED_FOLDER_HOST_PATH=

# Where that mount appears inside the container. Leave as-is unless you have a
# reason to change it.
SHARED_ROOT=/data/shared

# ---------------------------------------------------------------------------
# Embedding model cache
# ---------------------------------------------------------------------------
# Absolute host path of a pre-populated Hugging Face hub cache containing
# intfloat/multilingual-e5-small at revision
# 614241f622f53c4eeff9890bdc4f31cfecc418b3.
#
# The directory must contain models--intfloat--multilingual-e5-small/.
# Nothing is downloaded at startup: the containers run with HF_HUB_OFFLINE=1,
# so a missing cache fails loudly instead of fetching ~500MB on first request.
# See docs/deployment.md "Model cache".
EMBEDDING_CACHE_HOST_PATH=

# Where that cache appears inside the container.
EMBEDDING_CACHE_DIR=/opt/model-cache

# ---------------------------------------------------------------------------
# Claude (Anthropic) — OFF by default
# ---------------------------------------------------------------------------
# Leave LLM_PROVIDER empty to keep answer generation disabled. An API key
# present in the environment is not sufficient on its own: the provider must be
# named explicitly. Sending internal documents to an external service requires
# organizational approval first.
#
# To enable:  LLM_PROVIDER=anthropic  and set ANTHROPIC_API_KEY in .env.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=
ANTHROPIC_TIMEOUT_SECONDS=
ANTHROPIC_MAX_RETRIES=
ANTHROPIC_EFFORT=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Empty is correct for this deployment: nginx serves the UI and the API from
# one origin, so the browser makes no cross-origin request. Never set "*".
CORS_ALLOW_ORIGINS=
