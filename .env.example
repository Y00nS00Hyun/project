# Deployment configuration for the single-VM docker compose stack.
#
#   cp .env.example .env   &&   edit .env
#
# .env is git-ignored. Never put a real password or API key in this file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# "production" makes the API fail closed: SSO is not implemented yet, so every
# request is rejected with 401 until an identity provider exists. Do not set
# this to development/test on a deployed VM -- that enables the debug identity
# header.
APP_ENV=production

# Host port for nginx. The only port this stack publishes.
APP_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=docsearch
POSTGRES_USER=docsearch
# Required. Generate one, e.g. `openssl rand -base64 24`. No default is
# supplied on purpose.
POSTGRES_PASSWORD=

# Must match the three values above. "postgres" is the compose service name;
# the database is not reachable from outside the compose network.
# Alembic wants the +psycopg form and the application strips it back off, so
# this single value works for both.
DATABASE_URL=postgresql+psycopg://docsearch:CHANGE_ME@postgres:5432/docsearch

# ---------------------------------------------------------------------------
# Shared folder
# ---------------------------------------------------------------------------
# Absolute host path of the folder to index. Required -- there is deliberately
# no default, because silently scanning the wrong directory is worse than
# refusing to start. Mounted read-only; the system never writes to it.
SHARED_FOLDER_HOST_PATH=

# Where that mount appears inside the container. Leave as-is unless you have a
# reason to change it.
SHARED_ROOT=/data/shared

# ---------------------------------------------------------------------------
# Embedding model cache
# ---------------------------------------------------------------------------
# Absolute host path of a pre-populated Hugging Face hub cache containing
# intfloat/multilingual-e5-small at revision
# 614241f622f53c4eeff9890bdc4f31cfecc418b3.
#
# The directory must contain models--intfloat--multilingual-e5-small/.
# Nothing is downloaded at startup: the containers run with HF_HUB_OFFLINE=1,
# so a missing cache fails loudly instead of fetching ~500MB on first request.
# See docs/deployment.md "Model cache".
EMBEDDING_CACHE_HOST_PATH=

# Where that cache appears inside the container.
EMBEDDING_CACHE_DIR=/opt/model-cache

# ---------------------------------------------------------------------------
# Local login — development only, OFF by default
# ---------------------------------------------------------------------------
# A stand-in for the company SSO, so the app can be used from a browser by a
# person instead of by a header set with curl. NOT an operational auth system.
#
# Two conditions must both hold before it works at all:
#   * LOCAL_AUTH_ENABLED=true
#   * APP_ENV is a non-production value
# Neither APP_ENV nor any credential turns it on by itself, and production
# keeps the existing fail-closed behaviour regardless of what is set here.
#
# SELF_SIGNUP_ENABLED is a second switch: an environment can be given a fixed
# set of test accounts without also being open to new ones.
LOCAL_AUTH_ENABLED=false
SELF_SIGNUP_ENABLED=false

# Approving an account decides whether somebody may sign in. What they may read
# is decided in document_permissions -- see DOCUMENT_DEFAULT_ACCESS below.
LOCAL_AUTH_SESSION_DAYS=7

# Set true wherever the app is served over HTTPS. Left false for plain-HTTP
# development, where a Secure cookie would never be stored at all.
AUTH_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Search ranking
# ---------------------------------------------------------------------------
# A document whose body contains the query verbatim is boosted, but only when
# few enough of the candidate documents contain it. Both conditions, or the
# boost does not fire.
#
# The second condition is the important one. An exact match is not by itself
# evidence: "파일 다운로드" occurs verbatim in most documents and says nothing
# about which to read, while "Zookeeper" occurs in two and says a great deal.
#
# Selectivity is computed over the ACL-filtered candidate set, so documents the
# caller cannot read never influence it.
#
# BODY_EXACT_SELECTIVITY_MAX IS PROVISIONAL. Measured on a seven-document
# corpus where 0.5 means "at most three documents". On a shared folder of 500,
# a term in 70 of them scores 0.14 and would boost -- whether that is right has
# to be measured there. Re-measure as the corpus grows.
#
# Set BODY_EXACT_BOOST_WEIGHT=0 to restore the previous ranking exactly.
BODY_EXACT_BOOST_WEIGHT=0.10
BODY_EXACT_SELECTIVITY_MAX=0.50

# ---------------------------------------------------------------------------
# Who may read an ingested document
# ---------------------------------------------------------------------------
#   none              nobody, until somebody is granted access by hand
#   all_active_users  every approved (ACTIVE) account
#
# This installation runs all_active_users. That is sound ONLY because of a
# precondition that lives outside this file: the shared folder holds general
# internal documentation, and confidential, HR and payroll material is excluded
# from collection entirely rather than filtered out at read time.
#
# If that ever stops being true, change this first. Setting it to "none" and
# granting per-user or per-document access needs no code change -- the ACL has
# always supported both, and still runs before retrieval either way.
#
# It is never anonymous access. An unauthenticated request is still rejected;
# "all" means every account an administrator has approved.
#
# Applies to documents ingested from now on. To apply it to what is already
# there:
#   docker compose exec backend python -m auth grant-public-read \
#       --all-current-documents
DOCUMENT_DEFAULT_ACCESS=all_active_users

# ---------------------------------------------------------------------------
# External LLM — OFF by default, behind two separate switches
# ---------------------------------------------------------------------------
# Both must be set before a single document leaves this network. They are
# separate because they are separate decisions:
#
#   LLM_PROVIDER                   which service could be reached  (deployment)
#   DOCUMENT_EXTERNAL_LLM_ENABLED  may THIS corpus be sent to it   (approval)
#
# Neither is implied by the other, and neither is implied by an API key being
# present. A deployment with a provider configured and a valid key still sends
# nothing while the second switch is false.
#
# Keep DOCUMENT_EXTERNAL_LLM_ENABLED=false wherever the real internal shared
# folder is mounted. Set it true only in an environment holding synthetic or
# non-sensitive documents, and only deliberately.
#
# Governs both document-text features together -- summary generation and
# document-scoped chat -- so one cannot be on while the other is off.
#
# Recognised true values: 1, true, yes, on. Anything else, including unset,
# empty and a typo, means false.
DOCUMENT_EXTERNAL_LLM_ENABLED=false

# To enable:  LLM_PROVIDER=anthropic  and set ANTHROPIC_API_KEY in .env.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=
ANTHROPIC_TIMEOUT_SECONDS=
ANTHROPIC_MAX_RETRIES=
ANTHROPIC_EFFORT=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Empty is correct for this deployment: nginx serves the UI and the API from
# one origin, so the browser makes no cross-origin request. Never set "*".
CORS_ALLOW_ORIGINS=
